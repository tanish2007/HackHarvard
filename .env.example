# Copy to .env and fill in. .env is gitignored, never commit real values.

# Core (Tirth)
PORT=3000
# From https://aistudio.google.com/apikey. Without it, only the keyword rules run.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite. Try gemini-3.8-flash if tool picks are weak.
GEMINI_MODEL=
# Optional, e.g. low. Leave empty for the model's default.
GEMINI_THINKING_LEVEL=
# Optional. Set to 1 to log every tool call the agent makes.
RELAY_DEBUG=
# Where Core pushes actions it starts on its own (alerts, check-in timers).
# Each lane's own POST /actions, body { "actions": [...] }. Set the ports
# Text and Voice actually listen on. Empty means those pushes are dropped.
TEXT_ACTIONS_URL=http://localhost:3002/actions
VOICE_ACTIONS_URL=
# Optional. If set, POST /admin/alert and /admin/reset need it in the
# x-relay-admin header. Set it if the server is reachable through a tunnel.
RELAY_ADMIN_TOKEN=

# Data (Rudra). fake reads scenario.json. real calls FIRMS, NWS, OSRM, and Overpass.
DATA_MODE=fake
# Map key from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=

# Text (Tanish) and Voice (Junaid): add your own variables below.
# Messaging and location use the first Photon account, calls use the second.

# Voice (Junaid). Runs as its own process: cd voice && npm start.
# Copy these into voice/.env, which holds the real values. Never commit it.
# Core reaches Voice at VOICE_ACTIONS_URL above, so set it to http://localhost:3001/actions.
VOICE_PORT=3001
# Photon outbound SIP credentials (second Photon account, Voice, Outbound calls).
PHOTON_SIP_SERVER=sip.photon.codes
PHOTON_SIP_PORT=5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_NUMBER=
# ElevenLabs agent that speaks on calls, and the Photon number imported into it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Random string in the voice speech URL path (see voice/.env.example).
VOICE_LLM_SECRET=
