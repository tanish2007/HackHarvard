# Copy to .env and fill in. .env is gitignored, never commit real values.

# Core (Tirth)
PORT=3000
# From https://aistudio.google.com/apikey. Without it, only the keyword rules run.
GEMINI_API_KEY=
# Optional. Defaults to gemini-3.5-flash-lite. Try gemini-3.8-flash if tool picks are weak.
GEMINI_MODEL=
# Optional, e.g. low. Leave empty for the model's default.
GEMINI_THINKING_LEVEL=
# Optional. Set to 1 to log every tool call the agent makes.
RELAY_DEBUG=
# Where Core pushes actions it starts on its own (alerts, check-in timers).
# Each lane's own POST /actions, body { "actions": [...] }. Set the ports
# Text and Voice actually listen on. Empty means those pushes are dropped.
TEXT_ACTIONS_URL=http://localhost:3002/actions
VOICE_ACTIONS_URL=
# Optional. If set, POST /admin/alert and /admin/reset need it in the
# x-relay-admin header. Set it if the server is reachable through a tunnel.
RELAY_ADMIN_TOKEN=
# Live NASA fires with spread forecasts, shown next to the staged incident.
# Read-only, never alerts. Core reads them through the map server. Empty
# means http://127.0.0.1:8080. Set to off to turn them off.
LIVE_FIRES_URL=

# Data (Rudra). fake reads scenario.json. real calls FIRMS, NWS, OSRM, and Overpass.
DATA_MODE=fake
# Map key from https://firms.modaps.eosdis.nasa.gov/api/area/
FIRMS_MAP_KEY=
# Where Core reaches Rudra's data functions, which the map server (python
# dashboard/server.py) serves. Set it to http://localhost:8080 and Core asks it
# for shelters, routes, hazards and weather. Empty means Core answers from the
# scenario only. If the server is down or slow, Core falls back to the scenario.
DATA_URL=

# Text (Tanish) and Voice (Junaid): add your own variables below.
# Messaging and location use the first Photon account, calls use the second.

# Voice (Junaid). Runs as its own process: cd voice && npm start.
# Copy these into voice/.env, which holds the real values. Never commit it.
# Core reaches Voice at VOICE_ACTIONS_URL above, so set it to http://localhost:3001/actions.
VOICE_PORT=3001
# Photon outbound SIP credentials (second Photon account, Voice, Outbound calls).
PHOTON_SIP_SERVER=sip.photon.codes
PHOTON_SIP_PORT=5061
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_NUMBER=
# ElevenLabs agent that speaks on calls, and the Photon number imported into it.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
ELEVENLABS_PHONE_NUMBER_ID=
# Random string in the voice speech URL path (see voice/.env.example).
VOICE_LLM_SECRET=
# Languages your ElevenLabs agent has been set up for, as a comma list. A call to a person
# in one of these runs in their language. The agent must also allow the language override.
ELEVENLABS_LANGUAGES=es,gu,hi
# Optional. How long Core waits for the Gemini agent before using its fallback reply, in ms.
# Defaults to 3200. Raise it (for example 9000) if Gemini is slow, and keep VOICE_CORE_TIMEOUT_MS above it.
AGENT_TIMEOUT_MS=
# Optional. Other Gemini models to try, in order, when the main one answers 429 (its per-minute limit is
# used up) or 503. Each model has its own limit, so this adds capacity. Example: gemini-3.5-flash-lite,gemini-3.1-flash-lite
GEMINI_FALLBACK_MODELS=
# Optional. How long one Gemini model gets before the next one in GEMINI_FALLBACK_MODELS is tried, in ms.
# Defaults to 4000. A slow model otherwise uses up the whole wait. 0 turns the limit off.
GEMINI_ATTEMPT_TIMEOUT_MS=
