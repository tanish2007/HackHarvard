# Copy to .env and fill in. .env is gitignored, never commit real values.

# Core (Tirth)
PORT=3000
GEMINI_API_KEY=
GEMINI_MODEL=
# Where Core pushes actions it starts on its own (alerts, check-in timers).
TEXT_ACTIONS_URL=http://localhost:3000/text/actions
VOICE_ACTIONS_URL=http://localhost:3000/voice/actions

# Text (Tanish) and Voice (Junaid): add your own variables below.
# Messaging and location use the first Photon account, calls use the second.
