# Copy to .env and fill in. Never commit .env.

# Core server (Tirth). Base URL that accepts POST /event.
CORE_URL=http://localhost:3000

# Photon outbound SIP credentials (Photon dashboard, Voice, Outbound calls).
PHOTON_SIP_SERVER=sip.photon.codes
PHOTON_SIP_PORT=5061
PHOTON_SIP_TRANSPORT=tls
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_SIP_REALM=

# Photon number that calls come from, in E.164 form.
PHOTON_NUMBER=

# Number to ring for the "make the phone ring" test, in E.164 form.
TEST_CALL_TO=

# ElevenLabs (voice agent platform behind the Photon SIP trunk).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Id of the imported Photon number inside ElevenLabs (Phone Numbers page).
ELEVENLABS_PHONE_NUMBER_ID=

# Random string that goes in the custom LLM URL path, so strangers cannot post to it.
# Example: node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
VOICE_LLM_SECRET=
# Languages your ElevenLabs agent has been set up for, as a comma list. A call to a person
# in one of these runs in their language. The agent must also allow the language override.
ELEVENLABS_LANGUAGES=es,gu,hi
