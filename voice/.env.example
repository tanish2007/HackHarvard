# Copy to .env and fill in. Never commit .env.

# Core server (Tirth). Base URL that accepts POST /event.
CORE_URL=http://localhost:3000

# Photon outbound SIP credentials (Photon dashboard, Voice, Outbound calls).
PHOTON_SIP_SERVER=sip.photon.codes
PHOTON_SIP_PORT=5061
PHOTON_SIP_TRANSPORT=tls
PHOTON_SIP_USERNAME=
PHOTON_SIP_PASSWORD=
PHOTON_SIP_REALM=

# Photon number that calls come from, in E.164 form.
PHOTON_NUMBER=

# Number to ring for the "make the phone ring" test, in E.164 form.
TEST_CALL_TO=
